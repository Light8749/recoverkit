{
  "name": "recoverkit",
  "version": "1.0.0",
  "private": true,
  "description": "Sales-recovery SDK: finds people who registered but never bought, or bought once and never came back, and drafts human follow-ups.",
  "type": "module",
  "engines": { "node": ">=22.13" },
  "scripts": {
    "start": "node src/server.js",
    "demo": "node scripts/demo.js",
    "brand": "node scripts/build-brand.js",
    "cli": "node src/cli.js",
    "test": "node --test --test-reporter=spec \"test/*.test.js\"",
    "check": "node scripts/check-syntax.js && php -l sdk/php/RecoverKit.php",
    "audit": "npm audit --omit=dev"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.7.0"
  }
}
