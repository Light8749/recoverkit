{
  "name": "recoverkit-connector",
  "version": "1.0.1",
  "description": "RecoverKit read-only connector for MongoDB apps (Node.js). Reads your database where it lives and sends only hashes, dates and amounts.",
  "type": "module",
  "bin": {
    "recoverkit-connector": "recoverkit-connector.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "copy-core": "node scripts/copy-core.mjs",
    "pretest": "node scripts/copy-core.mjs",
    "test": "node --test --test-reporter=spec \"test/*.test.js\"",
    "prepack": "node scripts/copy-core.mjs"
  },
  "dependencies": {
    "mongodb": "7.7.0"
  },
  "devDependencies": {
    "mongodb-memory-server": "11.3.0"
  },
  "files": [
    "LICENSE",
    "README.md",
    "lib/",
    "recoverkit-connector.mjs"
  ],
  "license": "MIT",
  "keywords": [
    "recoverkit",
    "mongodb",
    "sales-recovery",
    "connector"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Light8749/recoverkit.git",
    "directory": "sdk/connector-node"
  },
  "homepage": "https://github.com/Light8749/recoverkit#readme",
  "bugs": {
    "url": "https://github.com/Light8749/recoverkit/issues"
  }
}
